<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Built-in NotifyIcon interop only; no package, and the WinForms implicit
         usings are removed so WPF Application/Clipboard stay unambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\overseer.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TheOverseer.App</RootNamespace>
    <AssemblyTitle>OVERSEER</AssemblyTitle>
    <!-- Release identity. The publish script passes all of these explicitly so the
         archive, the shipped binary and the build manifest cannot drift apart.
         A semantic prerelease suffix ("1.0.0-rc.1") is not a valid file version, so
         the numeric file/assembly version is separate from the release identifier:
         FileVersion stays "1.0.0.0" while InformationalVersion carries the release
         version and the source commit the candidate was built from. -->
    <Version>1.0.0</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">1.0.0.0</FileVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">1.0.0+local</InformationalVersion>
    <!-- The commit is supplied deliberately by the release script, never inferred
         from whatever the build machine happens to have checked out. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- WFO0003 asks WinForms apps to move DPI awareness out of the manifest.
         OVERSEER is WPF-first and needs PerMonitorV2 declared before the first
         HWND, so the manifest stays authoritative and the WinForms suggestion
         is intentionally not followed. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- The WindowsDesktop implicit-using set omits System.IO; keep the
         ordinary SDK behaviour for App code. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\overseer.ico" LogicalName="TheOverseer.App.Assets.overseer.ico" />
    <ProjectReference Include="..\TheOverseer.Core\TheOverseer.Core.csproj" />
    <ProjectReference Include="..\TheOverseer.UI\TheOverseer.UI.csproj" />
  </ItemGroup>
</Project>
