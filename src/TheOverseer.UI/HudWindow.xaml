<Window x:Class="TheOverseer.UI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:converters="clr-namespace:TheOverseer.UI.Converters"
        Title="OVERSEER"
        Width="280" Height="72"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource BackgroundBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="True" ShowActivated="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding Opacity}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <Style x:Key="StatusAccent" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="working"><Setter Property="BorderBrush" Value="{DynamicResource HealthyBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="attention"><Setter Property="BorderBrush" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="uncertain"><Setter Property="BorderBrush" Value="{DynamicResource DegradedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="BorderBrush" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="unavailable"><Setter Property="BorderBrush" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="working"><Setter Property="Foreground" Value="{DynamicResource HealthyBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="attention"><Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="uncertain"><Setter Property="Foreground" Value="{DynamicResource DegradedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="unavailable"><Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskViewTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter />
          </Border>
        </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HudScrollBarThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource AccentSecondaryBrush}" Opacity="0.75" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudScrollBar" TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource HudScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource HudScrollBar}" />
    <ResourceDictionary x:Key="HudScrollBarResources" />
    <Style x:Key="HudIconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource MetadataFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <!-- Header targets stay at least 24x24 DIP so they remain readable and
           reachable at the minimum window size. -->
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudTaskRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource RowSeparatorBrush}"
                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border Style="{StaticResource StatusAccent}" BorderThickness="3,0,0,0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudProjectHeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,7,10,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Header" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Header" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One observed-activity category fill. Shared by the strip bins and the
         legend swatches so the two can never disagree. Unknown is a hatch: it is
         missing observation, never a confirmed idle cell. -->
    <Style x:Key="ActivitySwatchFill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0.32" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Category}" Value="Idle">
          <Setter Property="Opacity" Value="0.09" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Unknown">
          <Setter Property="Background" Value="{DynamicResource ActivityUnknownBrush}" />
          <Setter Property="Opacity" Value="0.85" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Thinking">
          <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
          <Setter Property="Opacity" Value="0.7" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Planning">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Opacity" Value="0.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Working">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Opacity" Value="0.95" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Waiting">
          <Setter Property="Background" Value="{DynamicResource UnavailableBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource UnavailableBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Complete">
          <Setter Property="Background" Value="{DynamicResource HealthyBrush}" />
          <Setter Property="Opacity" Value="0.8" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One observed-activity bin. The tooltip and automation name carry category,
         interval, duration, evidence, coverage and concurrency, so the strip is
         readable without relying on colour. -->
    <DataTemplate x:Key="ActivityBinTemplate">
      <Grid Height="10" Margin="0,0,1,0" ToolTip="{Binding Description}"
            automation:AutomationProperties.Name="{Binding Description}">
        <Border Style="{StaticResource ActivitySwatchFill}" />
        <!-- Estimated segments (inferred active turn) are capped, not silently sold
             as a structured observation. -->
        <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource ForegroundBrush}" Opacity="0.55">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Evidence}" Value="Inferred">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ActivityLegendEntryTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,0,12,4" ToolTip="{Binding Description}"
                  automation:AutomationProperties.Name="{Binding Description}">
        <!-- An outline keeps the confirmed-idle slot readable as "blank", not a hole. -->
        <Border Width="14" Height="10" VerticalAlignment="Center" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Style="{StaticResource ActivitySwatchFill}" />
        <TextBlock Text="{Binding Label}" Margin="5,0,0,0" VerticalAlignment="Center"
                   FontFamily="{DynamicResource MetadataFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ActivityBinsPanel">
      <UniformGrid Rows="1" />
    </ItemsPanelTemplate>

    <!-- One task row: harness/provider badge, useful action, turn elapsed time and
         its own last-hour strip. An explicit click still activates the task. -->
    <DataTemplate x:Key="TaskRowTemplate">
      <Button Style="{StaticResource HudTaskRowButton}"
              Command="{Binding DataContext.ActivateTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}"
              automation:AutomationProperties.Name="{Binding DetailText}"
              automation:AutomationProperties.HelpText="{Binding NavigationHint}"
              ToolTip="{Binding DetailText}">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Copy task id" Click="OnCopyTaskIdClick" />
          </ContextMenu>
        </Button.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding NumberText}" Margin="0,0,8,0" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}"
                     Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{Binding RowSubtitle}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatusText}" FontWeight="Normal"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}" />
            <ItemsControl ItemsSource="{Binding TaskBins}"
                          ItemsPanel="{StaticResource ActivityBinsPanel}"
                          ItemTemplate="{StaticResource ActivityBinTemplate}"
                          Margin="0,3,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding AgeText}" ToolTip="{Binding AgeHint}" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}"
                     Foreground="{DynamicResource MutedBrush}" />
        </Grid>
      </Button>
    </DataTemplate>

    <!-- One expandable project row: the HUD's primary grouping. Project click
         toggles expansion; the task rows below keep their own activate action. -->
    <DataTemplate x:Key="ProjectRowTemplate">
      <StackPanel>
        <Button x:Name="ProjectHeader" Style="{StaticResource HudProjectHeaderButton}"
                Command="{Binding DataContext.ToggleProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding HeaderTooltip}"
                automation:AutomationProperties.Name="{Binding ToggleAutomationName}"
                automation:AutomationProperties.HelpText="{Binding HeaderTooltip}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ToggleGlyph}" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SummaryText}" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}" />
            <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Bins}"
                          ItemsPanel="{StaticResource ActivityBinsPanel}"
                          ItemTemplate="{StaticResource ActivityBinTemplate}"
                          Margin="0,5,0,0"
                          automation:AutomationProperties.Name="{Binding StripText}"
                          ToolTip="{Binding StripText}" />
          </Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskRowTemplate}"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource BackgroundBaseBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="{DynamicResource ShellBorderThickness}">
    <DockPanel>
      <Border x:Name="StatusLight" DockPanel.Dock="{Binding LightDock}" Width="{Binding LightWidth}" Height="{Binding LightHeight}"
              Visibility="{Binding LightVisible, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource StatusAccent}"
              Background="{Binding BorderBrush, RelativeSource={RelativeSource Self}}"
              ToolTip="{Binding StatusHeadline}" automation:AutomationProperties.Name="{Binding StatusHeadline}">
        <Thumb x:Name="LightResizeGrip" Cursor="{Binding LightResizeCursor}"
               DragStarted="OnLightResizeStarted" DragDelta="OnLightResizeDelta"
               ToolTip="Drag to resize the light. Right-click for position and width options."
               automation:AutomationProperties.Name="Resize status light">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
        </Thumb>
      </Border>
    <Grid x:Name="ContentGrid">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="SummaryRow" Height="72" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="2" Style="{StaticResource StatusAccent}" BorderThickness="6,0,0,0" IsHitTestVisible="False" />

      <!-- Static technical linework: no animation, never hit-testable. -->
      <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
        <Line X1="0" Y1="0.5" X2="280" Y2="0.5" Stroke="{DynamicResource DecorLineBrush}" StrokeThickness="1" />
        <Line X1="8.5" Y1="0" X2="8.5" Y2="72" Stroke="{DynamicResource DecorLineBrush}" StrokeThickness="1" Opacity="0.55" />
        <Line X1="271.5" Y1="0" X2="271.5" Y2="72" Stroke="{DynamicResource DecorLineBrush}" StrokeThickness="1" Opacity="0.55" />
        <Path Data="M 267,0 L 280,13" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.5" Opacity="0.85" />
        <Path Data="M 273,0 L 280,7" Stroke="{DynamicResource AccentSecondaryBrush}" StrokeThickness="1" Opacity="0.6" />
      </Canvas>

      <!-- Header: always pinned above the scrolling content, so it stays reachable
           in a short layout. Branding collapses before the controls do. -->
      <Grid x:Name="DragRegion" Grid.Row="0" Margin="14,8,14,8" Background="Transparent" Cursor="SizeAll"
            PreviewMouseDown="OnDragRegionMouseLeftButtonDown"
            PreviewMouseMove="OnDragRegionMouseMove"
            PreviewMouseUp="OnDragRegionMouseLeftButtonUp">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="BrandLabel" Grid.Column="0" Text="OVERSEER" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}" FontWeight="SemiBold"
                     Foreground="{DynamicResource MutedBrush}" />
          <WrapPanel x:Name="HeaderControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                      Background="Transparent" Cursor="Arrow" ForceCursor="True">
            <Ellipse x:Name="HealthDot" Width="7" Height="7" Margin="2,0,7,0" VerticalAlignment="Center"
                     automation:AutomationProperties.Name="{Binding HealthLine}"
                     ToolTip="{Binding StatusDetails}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource HealthyBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HealthLevelText}" Value="DEGRADED">
                      <Setter Property="Fill" Value="{DynamicResource DegradedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HealthLevelText}" Value="UNAVAILABLE">
                      <Setter Property="Fill" Value="{DynamicResource UnavailableBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <Button x:Name="LightToggleButton" Content="{Binding LightToggleText}" Command="{Binding ToggleLightCommand}"
                    ToolTip="{Binding LightToggleTooltip}" automation:AutomationProperties.Name="{Binding LightToggleTooltip}" Margin="0,0,2,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HudIconButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LightVisible}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="MuteButton" Style="{StaticResource HudIconButton}"
                    Content="{Binding MuteGlyph}" Command="{Binding ToggleMuteCommand}"
                    automation:AutomationProperties.Name="{Binding MuteTooltip}"
                    ToolTip="{Binding MuteTooltip}" Margin="0,0,2,0" />
            <Button x:Name="ExpandButton" Style="{StaticResource HudIconButton}"
                    Content="{Binding ExpandGlyph}" Click="OnToggleExpandedClick"
                    automation:AutomationProperties.Name="Expand or collapse the task list"
                    ToolTip="Expand or collapse (Escape collapses)" Margin="0,0,2,0" />
            <Button x:Name="MaximizeButton" Content="□" Click="OnMaximizeClick" Style="{StaticResource HudIconButton}"
                    ToolTip="Maximize HUD" automation:AutomationProperties.Name="Maximize HUD" Margin="0,0,2,0" />
            <Button x:Name="MenuButton" Style="{StaticResource HudIconButton}" Content="⋯" Click="OnMenuClick"
                    ToolTip="HUD menu" automation:AutomationProperties.Name="HUD menu" Margin="0,0,2,0" />
            <Button x:Name="CloseButton" Style="{StaticResource HudIconButton}" Content="✕" Click="OnCloseClick"
                    ToolTip="Hide to tray" automation:AutomationProperties.Name="Hide to tray" />
          </WrapPanel>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    x:Name="SummaryRegion"
                    automation:AutomationProperties.Name="{Binding SummaryText}">
          <TextBlock Text="{Binding WorkingCountText}" VerticalAlignment="Center"
                     FontFamily="{DynamicResource PrimaryFontFamily}"
                     FontSize="{DynamicResource FontSizeCount}" FontWeight="Bold"
                     Foreground="{DynamicResource ForegroundBrush}" />
          <TextBlock Text="WORKING" Margin="5,0,0,3" VerticalAlignment="Bottom"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}" FontWeight="SemiBold"
                     Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="·" Margin="9,0,9,2" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource BorderBrush}" />
          <TextBlock Text="{Binding NeedsHumanCountText}" VerticalAlignment="Center"
                     FontFamily="{DynamicResource PrimaryFontFamily}"
                     FontSize="{DynamicResource FontSizeCount}" FontWeight="Bold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CountsNeedAttention}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="NEEDS YOU" Margin="5,0,0,3" VerticalAlignment="Bottom"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}" FontWeight="SemiBold"
                     Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
        </Viewbox>

        <Grid Grid.Row="2">
        <Button x:Name="StatusButton" Cursor="SizeAll" Command="{Binding ShowCurrentTasksCommand}" Style="{StaticResource HudIconButton}"
                HorizontalContentAlignment="Left" Padding="0" MinHeight="0" ToolTip="{Binding StatusDetails}"
                automation:AutomationProperties.Name="Show current tasks">
        <TextBlock Text="{Binding CollapsedStatusLine}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatusText}"
                   FontFamily="{DynamicResource PrimaryFontFamily}"
                   FontSize="14"
                   ToolTip="{Binding StatusDetails}" />
        </Button>
        </Grid>
      </Grid>

      <!-- Expanded surface: scrolled content below the pinned header. -->
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly" Resources="{StaticResource HudScrollBarResources}">
      <Grid x:Name="ExpandedPanel" Background="{DynamicResource PanelSurfaceBrush}"
            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ExpandedDragRegion" Grid.Row="0" Margin="14,8,14,6" Background="Transparent" Cursor="SizeAll"
              PreviewMouseDown="OnDragRegionMouseLeftButtonDown"
              PreviewMouseMove="OnDragRegionMouseMove"
              PreviewMouseUp="OnDragRegionMouseLeftButtonUp">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding StatusHeadline}" TextWrapping="Wrap" FontSize="23" Style="{StaticResource StatusText}" ToolTip="{Binding StatusDetails}" />
            <TextBlock Text="{Binding MonitoringBadgeText}" FontSize="10" Margin="0,3,0,2"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding StatusDetails}"
                       automation:AutomationProperties.HelpText="{Binding StatusDetails}" />
          </StackPanel>

          <!-- Common hour axis and its small legend. Unknown is spelled out as
               missing observation so the strip never depends on colour alone. -->
          <StackPanel Grid.Row="1" Margin="0,6,0,0" ToolTip="{Binding LegendNote}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="12">
              <TextBlock Text="Last hour · each cell about a minute · now at the right" FontSize="{DynamicResource FontSizeMeta}"
                         FontFamily="{DynamicResource PrimaryFontFamily}" Foreground="{DynamicResource MutedBrush}" />
            </Viewbox>
            <ItemsControl x:Name="ActivityLegend" ItemsSource="{Binding Legend}"
                          ItemTemplate="{StaticResource ActivityLegendEntryTemplate}"
                          Margin="0,5,0,0"
                          automation:AutomationProperties.Name="{Binding LegendNote}"
                          automation:AutomationProperties.HelpText="{Binding LegendNote}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <Grid Grid.Row="2" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding MetaStripLine}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}"
                       ToolTip="{Binding CapabilityLine}" />
            <TextBlock Grid.Column="1" Text="{Binding VoiceStatusLine}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" MaxWidth="150"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}"
                       ToolTip="{Binding VoiceStatusLine}" />
          </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="6,0,10,5" ToolTip="{Binding TaskViewHint}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="NowTab" Content="Now" GroupName="TaskView" Style="{StaticResource TaskViewTab}" IsChecked="{Binding IsNowView}" />
            <RadioButton x:Name="RecentTab" Content="Recent" GroupName="TaskView" Style="{StaticResource TaskViewTab}" IsChecked="{Binding IsRecentView}" />
            <RadioButton x:Name="SessionTab" Content="This session" GroupName="TaskView" Style="{StaticResource TaskViewTab}" IsChecked="{Binding IsSessionView}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding RecentWindowLabel}" Command="{Binding CycleRecentWindowCommand}"
                  Style="{StaticResource HudIconButton}" Visibility="{Binding IsRecentView, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Change time window: 1, 2, 4, 8 or 24 hours" automation:AutomationProperties.Name="Change recent time window" />
        </Grid>

        <Grid Grid.Row="2">
          <Grid>
            <ItemsControl x:Name="ProjectList" ItemsSource="{Binding Projects}"
                          ItemTemplate="{StaticResource ProjectRowTemplate}" />
            <TextBlock Text="{Binding EmptyStateText}" Margin="14,4,14,10" TextWrapping="Wrap"
                       Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource MutedBrush}" />
          </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Margin="14,6,14,8" TextTrimming="CharacterEllipsis"
                   Text="{Binding FooterHint}"
                   Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}"
                   FontFamily="{DynamicResource MetadataFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource MutedBrush}" />
      </Grid>
      </ScrollViewer>
    </Grid>
    </DockPanel>
  </Border>
</Window>
