<Window x:Class="TheOverseer.UI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:converters="clr-namespace:TheOverseer.UI.Converters"
        Title="OVERSEER"
        Width="300" Height="96"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource BackgroundBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="True" ShowActivated="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding Opacity}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <Style x:Key="StatusAccent" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="working"><Setter Property="BorderBrush" Value="{DynamicResource HealthyBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="attention"><Setter Property="BorderBrush" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="uncertain"><Setter Property="BorderBrush" Value="{DynamicResource DegradedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="BorderBrush" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="unavailable"><Setter Property="BorderBrush" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="working"><Setter Property="Foreground" Value="{DynamicResource HealthyBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="attention"><Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="uncertain"><Setter Property="Foreground" Value="{DynamicResource DegradedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="unavailable"><Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskViewTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter />
          </Border>
        </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
    <!-- The filter is visible on its own line, and All is always present as the
         explicit reset, so an attention view can never look like an empty HUD. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chip" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <!-- Keep the native ComboBox behaviour, with the same palette on its face,
         popup and item states. Dynamic resources also follow a live theme swap. -->
    <Style x:Key="RecentHoursItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource BackgroundBaseBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource BackgroundBaseBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RecentHoursSelector" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource RecentHoursItem}" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Face" CornerRadius="6" BorderThickness="1"
                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                  <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                             Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="7,4,23,4" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Border x:Name="PopupSurface" MinWidth="{TemplateBinding ActualWidth}" CornerRadius="6" Padding="2"
                      Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HistoryToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource MetadataFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chip" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudScrollBarThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource AccentSecondaryBrush}" Opacity="0.75" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudScrollBar" TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource HudScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource HudScrollBar}" />
    <Style x:Key="HudIconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource MetadataFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <!-- Header targets stay at least 24x24 DIP so they remain readable and
           reachable at the minimum window size. -->
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The one summary line. Each half opens the matching filter, so the summary
         is also the way to reach work the current view does not show. -->
    <Style x:Key="SummarySectionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Section" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Section" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Section" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="Section" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudTaskRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource RowSeparatorBrush}"
                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border Style="{StaticResource StatusAccent}" BorderThickness="3,0,0,0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudProjectHeaderButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,7,4,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Header" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Header" Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="Header" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One observed-activity category fill. Shared by the strip bins and the
         legend swatches so the two can never disagree. Unknown is a hatch: it is
         missing observation, never a confirmed idle cell. -->
    <Style x:Key="ActivitySwatchFill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0.32" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Category}" Value="Idle">
          <Setter Property="Opacity" Value="0.09" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Unknown">
          <Setter Property="Background" Value="{DynamicResource ActivityUnknownBrush}" />
          <Setter Property="Opacity" Value="0.85" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Thinking">
          <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
          <Setter Property="Opacity" Value="0.7" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Planning">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Opacity" Value="0.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Working">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Opacity" Value="0.95" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Waiting">
          <Setter Property="Background" Value="{DynamicResource UnavailableBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource UnavailableBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Category}" Value="Complete">
          <Setter Property="Background" Value="{DynamicResource HealthyBrush}" />
          <Setter Property="Opacity" Value="0.8" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One observed-activity bin. The tooltip and automation name carry category,
         interval, duration, evidence, coverage and concurrency, so the strip is
         readable without relying on colour. -->
    <DataTemplate x:Key="ActivityBinTemplate">
      <Grid Height="10" Margin="0,0,1,0" ToolTip="{Binding Description}"
            automation:AutomationProperties.Name="{Binding Description}">
        <Border Style="{StaticResource ActivitySwatchFill}" />
        <!-- Estimated segments (inferred active turn) are capped, not silently sold
             as a structured observation. -->
        <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource ForegroundBrush}" Opacity="0.55">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Evidence}" Value="Inferred">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ActivityLegendEntryTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,0,12,4" ToolTip="{Binding Description}"
                  automation:AutomationProperties.Name="{Binding Description}">
        <!-- An outline keeps the confirmed-idle slot readable as "blank", not a hole. -->
        <Border Width="14" Height="10" VerticalAlignment="Center" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Style="{StaticResource ActivitySwatchFill}" />
        <TextBlock Text="{Binding Label}" Margin="5,0,0,0" VerticalAlignment="Center"
                   FontFamily="{DynamicResource MetadataFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ActivityBinsPanel">
      <UniformGrid Rows="1" />
    </ItemsPanelTemplate>

    <!-- One reporting source: identity, its own state and evidence freshness, the typed
         capability distinction and one next action. -->
    <DataTemplate x:Key="HealthDetailTemplate">
      <StackPanel Margin="0,6,0,0" ToolTip="{Binding Description}"
                  automation:AutomationProperties.Name="{Binding Description}">
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"
                   FontFamily="{DynamicResource MetadataFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                   FontFamily="{DynamicResource MetadataFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Text="{Binding Capability}" TextWrapping="Wrap"
                   FontFamily="{DynamicResource MetadataFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Text="{Binding Action}" TextWrapping="Wrap"
                   FontFamily="{DynamicResource PrimaryFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource ForegroundBrush}" />
      </StackPanel>
    </DataTemplate>

    <!-- One task row: title, harness plus one concise status, quiet turn elapsed
         time. An explicit click still activates the task; History is a separate
         control that never activates it. -->
    <DataTemplate x:Key="TaskRowTemplate">
      <Button Style="{StaticResource HudTaskRowButton}"
              Command="{Binding DataContext.ActivateTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}"
              automation:AutomationProperties.Name="{Binding DetailText}"
              automation:AutomationProperties.HelpText="{Binding NavigationHint}"
              ToolTip="{Binding DetailText}">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Copy task id" Click="OnCopyTaskIdClick" />
          </ContextMenu>
        </Button.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="TaskNumbers" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding NumberText}" Margin="0,0,8,0" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}"
                     Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{Binding RowSubtitle}" TextTrimming="CharacterEllipsis" Style="{StaticResource StatusText}" FontWeight="Normal"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}" />
            <ItemsControl ItemsSource="{Binding TaskBins}"
                          ItemsPanel="{StaticResource ActivityBinsPanel}"
                          ItemTemplate="{StaticResource ActivityBinTemplate}"
                          Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisibility}}"
                          Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock Text="{Binding AgeText}" ToolTip="{Binding AgeHint}" HorizontalAlignment="Right"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}" />
            <ToggleButton Content="History" Margin="0,2,0,0"
                          IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                          automation:AutomationProperties.Name="{Binding HistoryAutomationName}"
                          ToolTip="{Binding HistoryAutomationName}">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource HistoryToggle}">
                  <!-- Reserve space and keyboard access while quieting repeated labels. -->
                  <Setter Property="Opacity" Value="0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- One expandable project row: the HUD's primary grouping. Project click
         toggles expansion; History discloses this project's hour strip, which is
         also where the shared axis and legend appear. -->
    <DataTemplate x:Key="ProjectRowTemplate">
      <StackPanel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ProjectHeader" Grid.Column="0" Style="{StaticResource HudProjectHeaderButton}"
                  Command="{Binding DataContext.ToggleProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding}"
                  ToolTip="{Binding HeaderTooltip}"
                  automation:AutomationProperties.Name="{Binding ToggleAutomationName}"
                  automation:AutomationProperties.HelpText="{Binding HeaderTooltip}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding ToggleGlyph}" Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource MetadataFontFamily}"
                         FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource MutedBrush}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource PrimaryFontFamily}"
                           FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryText}" Margin="0,1,0,0"
                           FontFamily="{DynamicResource MetadataFontFamily}"
                           FontSize="{DynamicResource FontSizeMeta}"
                           Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Grid>
          </Button>
          <ToggleButton Grid.Column="1" Style="{StaticResource HistoryToggle}" Content="History"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                        automation:AutomationProperties.Name="{Binding HistoryAutomationName}"
                        ToolTip="{Binding HistoryAutomationName}" />
        </Grid>
        </Border>
        <ItemsControl x:Name="ProjectHistory" ItemsSource="{Binding Bins}" Margin="14,4,12,4"
                      ItemsPanel="{StaticResource ActivityBinsPanel}"
                      ItemTemplate="{StaticResource ActivityBinTemplate}"
                      Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisibility}}"
                      automation:AutomationProperties.Name="{Binding StripText}"
                      ToolTip="{Binding StripText}" />
        <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskRowTemplate}"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource BackgroundBaseBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="{DynamicResource ShellBorderThickness}">
    <Grid>
    <DockPanel>
      <Border x:Name="StatusLight" DockPanel.Dock="{Binding LightDock}" Width="{Binding LightWidth}" Height="{Binding LightHeight}"
              Visibility="{Binding LightVisible, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource StatusAccent}"
              Background="{Binding BorderBrush, RelativeSource={RelativeSource Self}}"
              ToolTip="{Binding StatusHeadline}" automation:AutomationProperties.Name="{Binding StatusHeadline}">
        <Thumb x:Name="LightResizeGrip" Cursor="{Binding LightResizeCursor}"
               DragStarted="OnLightResizeStarted" DragDelta="OnLightResizeDelta"
               ToolTip="Drag to resize the light. Right-click for position and width options."
               automation:AutomationProperties.Name="Resize status light">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
        </Thumb>
      </Border>
    <Grid x:Name="ContentGrid">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="SummaryRow" Height="Auto" MinHeight="96" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- The left state accent is hidden while the light already carries state. -->
      <Border Grid.RowSpan="2" Style="{StaticResource StatusAccent}" BorderThickness="6,0,0,0" IsHitTestVisible="False"
              Visibility="{Binding LeftAccentVisible, Converter={StaticResource BoolToVisibility}}" />

      <!-- Header: always pinned above the scrolling content, so it stays reachable
           in a short layout. Branding collapses before the controls do. -->
      <Grid x:Name="DragRegion" Grid.Row="0" Margin="14,8,14,8" Background="Transparent" Cursor="SizeAll"
            PreviewMouseDown="OnDragRegionMouseLeftButtonDown"
            PreviewMouseMove="OnDragRegionMouseMove"
            PreviewMouseUp="OnDragRegionMouseLeftButtonUp">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="BrandLabel" Grid.Column="0" Text="OVERSEER" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}" FontWeight="SemiBold"
                     Foreground="{DynamicResource MutedBrush}" />
          <WrapPanel x:Name="HeaderControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                      Background="Transparent" Cursor="Arrow" ForceCursor="True">
            <Button x:Name="LightToggleButton" Content="{Binding LightToggleText}" Command="{Binding ToggleLightCommand}"
                    ToolTip="{Binding LightToggleTooltip}" automation:AutomationProperties.Name="{Binding LightToggleTooltip}" Margin="0,0,2,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HudIconButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LightVisible}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="MuteButton" Command="{Binding ToggleMuteCommand}"
                    automation:AutomationProperties.Name="{Binding MuteTooltip}"
                    ToolTip="{Binding MuteTooltip}" Margin="0,0,2,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HudIconButton}">
                  <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Grid Width="13" Height="15">
                <Path Data="M 6,1 C 4,1 4,2 4,3 L 4,7 C 4,9 8,9 8,7 L 8,3 C 8,2 8,1 6,1 M 2,6 L 2,8 C 2,12 10,12 10,8 L 10,6 M 6,11 L 6,14 M 3,14 L 9,14"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                <Path Data="M 1,1 L 12,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Button>
            <Button x:Name="ExpandButton" Style="{StaticResource HudIconButton}"
                    Content="{Binding ExpandGlyph}" Click="OnToggleExpandedClick"
                    automation:AutomationProperties.Name="Expand or collapse the task list"
                    ToolTip="Expand or collapse (Escape collapses)" Margin="0,0,2,0" />
            <Button x:Name="MaximizeButton" Content="□" Click="OnMaximizeClick" Style="{StaticResource HudIconButton}"
                    ToolTip="Maximize HUD" automation:AutomationProperties.Name="Maximize HUD" Margin="0,0,2,0" />
            <Button x:Name="MenuButton" Style="{StaticResource HudIconButton}" Content="⋯" Click="OnMenuClick"
                    ToolTip="HUD menu" automation:AutomationProperties.Name="HUD menu" Margin="0,0,2,0" />
            <Button x:Name="CloseButton" Style="{StaticResource HudIconButton}" Content="✕" Click="OnCloseClick"
                    ToolTip="Hide to tray" automation:AutomationProperties.Name="Hide to tray" />
          </WrapPanel>
        </Grid>

        <!-- One summary. Attention is first because it is the reason to look. -->
        <WrapPanel x:Name="SummaryRegion" Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0"
                   automation:AutomationProperties.Name="{Binding SummaryText}">
          <Button Style="{StaticResource SummarySectionButton}" Command="{Binding ShowAttentionCommand}"
                  automation:AutomationProperties.Name="Needs you - show tasks that need you"
                  ToolTip="Show tasks that need you, including async requests. + means at least this many observed tasks; coverage is incomplete. ? means unavailable.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding NeedsHumanCountText}" VerticalAlignment="Center"
                         FontFamily="{DynamicResource PrimaryFontFamily}"
                         FontSize="{DynamicResource FontSizeCount}" FontWeight="Bold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CountsNeedAttention}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource UnavailableBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="Needs you" Margin="5,0,0,2" VerticalAlignment="Bottom"
                         FontFamily="{DynamicResource MetadataFontFamily}"
                         FontSize="{DynamicResource FontSizeMeta}" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Button>
          <TextBlock Text="·" Margin="6,0,6,1" VerticalAlignment="Center"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource BorderBrush}" />
          <Button Style="{StaticResource SummarySectionButton}" Command="{Binding ShowWorkingCommand}"
                  automation:AutomationProperties.Name="Working - show tasks that are working"
                  ToolTip="Show tasks working now. + means at least this many observed tasks; coverage is incomplete. ? means unavailable.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding WorkingCountText}" VerticalAlignment="Center"
                         FontFamily="{DynamicResource PrimaryFontFamily}"
                         FontSize="{DynamicResource FontSizeCount}" FontWeight="Bold"
                         Foreground="{DynamicResource ForegroundBrush}" />
              <TextBlock Text="Working" Margin="5,0,0,2" VerticalAlignment="Bottom"
                         FontFamily="{DynamicResource MetadataFontFamily}"
                         FontSize="{DynamicResource FontSizeMeta}" FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Button>
        </WrapPanel>

        <!-- One clickable health control, in the pinned area. It opens per-source
             detail instead of pushing a long list above the projects. -->
        <Button x:Name="HealthButton" Grid.Row="2" Style="{StaticResource HudIconButton}" Margin="0,3,0,0"
                HorizontalContentAlignment="Left" Padding="2,2" MinHeight="20"
                Command="{Binding ToggleHealthCommand}"
                ToolTip="{Binding StatusDetails}"
                automation:AutomationProperties.Name="{Binding HealthLabel}"
                automation:AutomationProperties.HelpText="{Binding StatusDetails}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="HealthDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                     automation:AutomationProperties.Name="{Binding HealthLine}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource HealthyBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HealthLevelText}" Value="DEGRADED">
                      <Setter Property="Fill" Value="{DynamicResource DegradedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HealthLevelText}" Value="UNAVAILABLE">
                      <Setter Property="Fill" Value="{DynamicResource UnavailableBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding HealthLabel}" VerticalAlignment="Center"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Expanded surface: scrolled content below the pinned header. -->
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly">
      <Grid x:Name="ExpandedPanel" Background="{DynamicResource PanelSurfaceBrush}"
            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ExpandedDragRegion" Grid.Row="0" Margin="14,8,14,4" Background="Transparent" Cursor="SizeAll"
              PreviewMouseDown="OnDragRegionMouseLeftButtonDown"
              PreviewMouseMove="OnDragRegionMouseMove"
              PreviewMouseUp="OnDragRegionMouseLeftButtonUp">
          <TextBlock Text="{Binding MetaStripLine}" TextTrimming="CharacterEllipsis"
                     FontFamily="{DynamicResource MetadataFontFamily}"
                     FontSize="{DynamicResource FontSizeMeta}"
                     Foreground="{DynamicResource MutedBrush}"
                     ToolTip="{Binding StatusDetails}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="14,0,14,2" ToolTip="{Binding TaskViewHint}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="NowTab" Content="Now" GroupName="TaskView" Style="{StaticResource TaskViewTab}" IsChecked="{Binding IsNowView}" />
            <RadioButton x:Name="RecentTab" Content="Recent" GroupName="TaskView" Style="{StaticResource TaskViewTab}" IsChecked="{Binding IsRecentView}" />
            <RadioButton x:Name="SessionTab" Content="This session" GroupName="TaskView" Style="{StaticResource TaskViewTab}" IsChecked="{Binding IsSessionView}" />
            <!-- The Recent window is an explicit choice, not a hidden cycling gesture. -->
            <ComboBox x:Name="RecentHoursBox" Style="{StaticResource RecentHoursSelector}" Margin="6,2,0,0" MinWidth="56" VerticalAlignment="Center"
                      ItemsSource="{Binding RecentHourOptions}"
                      SelectedItem="{Binding SelectedRecentHours, Mode=TwoWay}"
                      ItemStringFormat="{}{0}h"
                      Visibility="{Binding IsRecentView, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Choose how far back Recent looks"
                      automation:AutomationProperties.Name="Recent time window in hours" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,2,14,4">
          <RadioButton x:Name="FilterAll" Content="All" GroupName="TaskFilter" Style="{StaticResource FilterChip}"
                       IsChecked="{Binding IsFilterAll}" Command="{Binding SetTaskFilterCommand}" CommandParameter="all"
                       ToolTip="Show every row in this view" automation:AutomationProperties.Name="Show all rows" />
          <RadioButton x:Name="FilterAttention" Content="Needs you" GroupName="TaskFilter" Style="{StaticResource FilterChip}"
                       IsChecked="{Binding IsFilterAttention}" Command="{Binding SetTaskFilterCommand}" CommandParameter="attention"
                       ToolTip="Show only rows that need you" automation:AutomationProperties.Name="Show rows that need you" />
          <RadioButton x:Name="FilterWorking" Content="Working" GroupName="TaskFilter" Style="{StaticResource FilterChip}"
                       IsChecked="{Binding IsFilterWorking}" Command="{Binding SetTaskFilterCommand}" CommandParameter="working"
                       ToolTip="Show only rows that are working" automation:AutomationProperties.Name="Show working rows" />
        </StackPanel>

        <!-- The hour axis and legend belong to the history area and only appear with
             an open history disclosure. -->
        <StackPanel x:Name="HistoryArea" Grid.Row="3" Margin="14,2,14,4"
                    Visibility="{Binding ShowHistoryLegend, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="{Binding LegendNote}">
          <TextBlock Text="Last hour · each cell about a minute · now at the right"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSizeMeta}"
                     FontFamily="{DynamicResource PrimaryFontFamily}" Foreground="{DynamicResource MutedBrush}" />
          <ItemsControl x:Name="ActivityLegend" ItemsSource="{Binding Legend}"
                        ItemTemplate="{StaticResource ActivityLegendEntryTemplate}"
                        Margin="0,5,0,0"
                        automation:AutomationProperties.Name="{Binding LegendNote}"
                        automation:AutomationProperties.HelpText="{Binding LegendNote}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="4">
          <StackPanel>
            <Border Margin="14,4,14,10" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasFocusPins, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="FOCUS · YOUR PINNED OBJECTIVES" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <ItemsControl ItemsSource="{Binding FocusPins}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,6,0,0" ToolTip="{Binding Reason}">
                      <TextBlock Text="{Binding Project}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Objective}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          <Grid>
            <ItemsControl x:Name="ProjectList" ItemsSource="{Binding Projects}" Grid.IsSharedSizeScope="True"
                          ItemTemplate="{StaticResource ProjectRowTemplate}" />
            <TextBlock Text="{Binding EmptyStateText}" Margin="14,4,14,10" TextWrapping="Wrap"
                       Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource MutedBrush}" />
          </Grid>
          </StackPanel>
        </Grid>

        <!-- Feedback for navigation, tray, startup and save failures. It sits at the
             end of the scrolled content so it never becomes a permanent instruction
             line, and it is hidden entirely when there is nothing to report. -->
        <TextBlock x:Name="StatusLine" Grid.Row="5" Text="{Binding FooterHint}" Margin="14,2,14,8" TextWrapping="Wrap"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"
                   automation:AutomationProperties.Name="{Binding FooterHint}"
                   FontFamily="{DynamicResource PrimaryFontFamily}"
                   FontSize="{DynamicResource FontSizeMeta}"
                   Foreground="{DynamicResource MutedBrush}" />
      </Grid>
      </ScrollViewer>
    </Grid>
    </DockPanel>
      <!-- Health details: per source, freshness, capabilities and the next action. -->
      <Popup x:Name="HealthPopup" PlacementTarget="{Binding ElementName=HealthButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
             IsOpen="{Binding IsHealthOpen, Mode=TwoWay}">
        <Border Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="10" MaxWidth="380" Margin="0,2,8,8">
          <StackPanel>
            <TextBlock Text="{Binding MonitoringTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{Binding MonitoringDetail}" TextWrapping="Wrap" Margin="0,3,0,0"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}" />
            <ItemsControl ItemsSource="{Binding HealthDetails}" ItemTemplate="{StaticResource HealthDetailTemplate}"
                          Margin="0,4,0,0" />
            <TextBlock Text="{Binding HealthNextAction}" TextWrapping="Wrap" Margin="0,6,0,0"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{Binding CapabilityLine}" TextWrapping="Wrap" Margin="0,6,0,0"
                       FontFamily="{DynamicResource MetadataFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource MutedBrush}" />
            <!-- Failure-only: rendered when notifications are enabled and the last
                 attempt did not speak. Nothing appears while voice is muted or working,
                 so this is not a permanent status sentence. -->
            <TextBlock x:Name="VoiceFailureText" Text="{Binding VoiceFailureLine}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding VoiceFailed, Converter={StaticResource BoolToVisibility}}"
                       automation:AutomationProperties.Name="{Binding VoiceFailureLine}"
                       FontFamily="{DynamicResource PrimaryFontFamily}"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource UnavailableBrush}" />
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
