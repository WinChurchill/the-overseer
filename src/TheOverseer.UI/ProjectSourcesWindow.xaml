<Window x:Class="TheOverseer.UI.ProjectSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TheOverseer.UI.Converters"
        Title="OVERSEER — Projects &amp; sources" Width="620" Height="600" MinWidth="320" MinHeight="220"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBaseBrush}"
        Foreground="{DynamicResource ForegroundBrush}" FontSize="13">
  <Window.Resources>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" /></Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding Note}" VerticalAlignment="Center" FontSize="11"
                 Foreground="{DynamicResource MutedBrush}" />
      <Button Content="Close" Click="OnClose" HorizontalAlignment="Right" Margin="12,0,0,0" />
    </DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Projects &amp; sources" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Discovered harness sources and the project buckets they resolve to. Local roots are never shown; enablement is additive and never resets another preference."
                 Margin="0,6,0,14" Foreground="{DynamicResource MutedBrush}" />
      <TextBlock Text="SOURCES" FontWeight="SemiBold" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <ItemsControl x:Name="SourceRows" ItemsSource="{Binding Sources}" Margin="0,6,0,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <StackPanel>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Margin="20,4,0,0" FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- A missing harness is a setup state, not an error: name the next action
             instead of showing an empty page. -->
        <StackPanel Visibility="{Binding HasSources, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,4,0,14">
          <TextBlock Text="No optional harness source is installed. OVERSEER still monitors Codex."
                     Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="To add one, run the installer in the integrations folder that shipped with OVERSEER (integrations/claude-code for Claude Code, integrations/deepseek-harness for dsh), then restart OVERSEER so it is discovered."
                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" FontSize="11" />
        </StackPanel>
        <TextBlock Text="PROJECT BUCKETS" FontWeight="SemiBold" />
        <ItemsControl x:Name="ProjectRows" ItemsSource="{Binding Projects}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
