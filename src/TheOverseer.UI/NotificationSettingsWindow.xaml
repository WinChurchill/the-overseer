<Window x:Class="TheOverseer.UI.NotificationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:TheOverseer.Core.Configuration;assembly=TheOverseer.Core"
        Title="OVERSEER — Light &amp; voice" Width="650" Height="740" MinWidth="280" MinHeight="200"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBaseBrush}"
        Foreground="{DynamicResource ForegroundBrush}" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" /><Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="{DynamicResource PanelOverlayBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" /></Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Content="Stop preview" Click="OnStop" />
      <Button Content="Close" Click="OnClose" HorizontalAlignment="Right" />
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Light &amp; voice" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Changes save automatically. Preview is the only control that plays audio." Margin="0,6,0,16" Foreground="{DynamicResource MutedBrush}" />
      <TextBlock Text="APPEARANCE" FontWeight="SemiBold" />
      <WrapPanel Margin="0,8,0,8">
        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="ThemeBox" Width="100" SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <ComboBoxItem Content="Dark" Tag="{x:Static config:HudTheme.Dark}" />
          <ComboBoxItem Content="Light" Tag="{x:Static config:HudTheme.Light}" />
        </ComboBox>
        <TextBlock Text="Opacity" VerticalAlignment="Center" Margin="18,0,8,0" />
        <Slider x:Name="OpacitySlider" Width="130" Minimum="0.65" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding OpacityPercentLabel}" Margin="8,0,0,0" VerticalAlignment="Center" />
      </WrapPanel>
      <WrapPanel Margin="0,0,0,16">
        <CheckBox x:Name="StartupBox" Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=OneWay}" Click="OnStartup" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="ResetPositionButton" Content="Reset position" Click="OnResetPosition" />
        <Button x:Name="MinimizeButton" Content="Minimize HUD" Click="OnMinimize" />
      </WrapPanel>
      <TextBlock Text="STATUS LIGHT" FontWeight="SemiBold" />
      <WrapPanel Margin="0,8,0,8">
        <TextBlock Text="Position" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="LightPositionBox" Width="100" SelectedValuePath="Tag" SelectedValue="{Binding LightPosition}">
          <ComboBoxItem Content="Off" Tag="off" /><ComboBoxItem Content="Top" Tag="top" />
          <ComboBoxItem Content="Bottom" Tag="bottom" /><ComboBoxItem Content="Left" Tag="left" /><ComboBoxItem Content="Right" Tag="right" />
        </ComboBox>
        <TextBlock Text="Size" VerticalAlignment="Center" Margin="18,0,8,0" />
        <Slider Width="130" Minimum="6" Maximum="128" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding LightSize}" />
        <TextBlock Text="{Binding LightSize, StringFormat={}{0} DIP}" Margin="8,0,0,0" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Text="Green: working · Red: needs attention / offline · Amber: uncertain · Neutral: idle" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16" />
      <TextBlock Text="VOICE PROVIDER" FontWeight="SemiBold" />
      <WrapPanel Margin="0,8,0,4">
        <TextBlock Text="Provider" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="ProviderBox" Width="250" SelectedValuePath="Tag" SelectionChanged="OnProviderChanged">
          <ComboBoxItem Content="Voice pack (local recordings)" Tag="pack" />
          <ComboBoxItem Content="Windows speech baseline (offline)" Tag="speech" />
          <ComboBoxItem Content="TTS endpoint" Tag="tts" />
        </ComboBox>
        <Button x:Name="UseBaselineButton" Content="Use baseline" Click="OnUseBaseline" Margin="8,0,0,0" />
      </WrapPanel>
      <TextBlock x:Name="BaselineStatusText" Text="Windows speech baseline (offline): checking…" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
      <TextBlock Text="The selected provider is used for enabled situations only. Opening this panel is silent and sends no request." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16" />
      <WrapPanel>
        <TextBlock Text="VOICE RECORDINGS" FontWeight="SemiBold" VerticalAlignment="Center" />
        <CheckBox x:Name="MuteBox" Content="Mute notifications" IsChecked="{Binding IsMuted}" Margin="12,0,0,0" />
      </WrapPanel>
      <TextBlock Text="Nine situations. An assigned WAV always wins; otherwise the selected provider speaks. Opening tasks, changing settings, cancellations and immediate work resumption stay silent." Margin="0,8,0,4" Foreground="{DynamicResource MutedBrush}" />
      <TextBlock Text="WAV · up to 15 seconds / 4 MiB · recommended: mono, 16-bit PCM, 44.1 kHz" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
    </StackPanel>
      <ItemsControl x:Name="Rows">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
              <StackPanel>
                <CheckBox Content="{Binding Definition.Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Definition.Trigger}" FontSize="12" Margin="20,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding Definition.Script}" Margin="20,5,0,0" />
                <TextBlock Text="{Binding Status}" Margin="20,4,0,8" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <WrapPanel Margin="20,0,0,0">
                  <Button Content="Assign WAV…" Click="OnAssign" /><Button Content="Preview" Click="OnPreview" /><Button Content="Use selected provider" Click="OnClear" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
